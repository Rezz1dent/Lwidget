<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="org.breezyweather.READ_PROVIDER" />
    <uses-permission android:name="org.breezyweather.debug.READ_PROVIDER" />
    <queries>
        <package android:name="org.breezyweather" />
        <package android:name="org.breezyweather.debug" />
    </queries>
    <application
        android:label="Breezy KWGT Bridge • Provider"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity
            android:name="com.leanbitlab.breezybridge.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <receiver
            android:name="com.leanbitlab.breezybridge.ContentUpdateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.breezyweather.ACTION_UPDATE_NOTIFIER"/>
                <action android:name="org.breezyweather.debug.ACTION_UPDATE_NOTIFIER"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>