<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    
    >
    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignTop="@id/inner_container"
        android:layout_alignBottom="@id/inner_container"
        android:layout_alignStart="@id/inner_container"
        android:layout_alignEnd="@id/inner_container"
        android:src="@drawable/widget_bg_fill"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/widget_outline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignTop="@id/inner_container"
        android:layout_alignBottom="@id/inner_container"
        android:layout_alignStart="@id/inner_container"
        android:layout_alignEnd="@id/inner_container"
        android:src="@drawable/widget_bg_outline"
        android:visibility="visible"
        android:importantForAccessibility="no" />
    <RelativeLayout
        android:id="@+id/inner_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="0dp">

    <!-- Header: time and date occupy a single non-overlapping left column. -->
    <LinearLayout
        android:id="@+id/left_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:orientation="vertical"
        android:clipChildren="true">
    <!-- Time (Top Left) -->
    
    <LinearLayout
        android:id="@+id/time_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:gravity="center_vertical">
        <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:format12Hour="h:mm"
        android:format24Hour="H:mm"
        android:textSize="48sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:includeFontPadding="false"/>
    </LinearLayout>

    <!-- Date (Below Time) -->
    
    <LinearLayout
        android:id="@+id/date_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/time_container"
        android:layout_alignParentStart="true"
        android:gravity="center_vertical">
        <TextClock
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:format12Hour="EEEE, MMMM dd"
        android:format24Hour="EEEE, MMMM dd"
        android:textSize="18sp"
        android:textColor="#CCFFFFFF"
        />

        <LinearLayout
            android:id="@+id/layout_world_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/icon_world_clock"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_world"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/text_world_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_next_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/text_alarm_divider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:includeFontPadding="false"
                android:layout_marginEnd="6dp" />
            <ImageView
                android:id="@+id/icon_next_alarm"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_alarm"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/text_next_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    </LinearLayout>

    <!-- Battery (Top Right) -->
    <TextView
        android:id="@+id/text_battery"
        android:layout_toEndOf="@id/left_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="--%"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:includeFontPadding="false"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>

    <!-- Three-line weather content; constrained to the right of the whole clock/date header. -->
    <LinearLayout
        android:id="@+id/layout_weather_condition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:clipChildren="true"
        android:layout_toEndOf="@id/left_header"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/weather_top_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">
            <TextView
                android:id="@+id/text_weather_temperature"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#CCFFFFFF"
                android:textSize="20sp"
                android:includeFontPadding="false" />
            <ImageView
                android:id="@+id/icon_weather"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_weather_sunny"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <TextView
            android:id="@+id/text_weather_feels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/text_weather_condition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Temp (Below Battery) -->
    <TextView
        android:id="@+id/text_temp"
        android:layout_toEndOf="@id/left_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="--°C"
        android:textColor="#CCFFFFFF"
        android:textSize="18sp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>

    <!-- Data Usage (Below Temp) -->
    <TextView
        android:id="@+id/text_data_usage"
        android:layout_toEndOf="@id/left_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-- MB"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        />
    <TextView
        android:id="@+id/text_storage"
        android:layout_toEndOf="@id/left_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        />
    <TextView
        android:id="@+id/text_ram"
        android:layout_toEndOf="@id/left_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        />

    <!-- Steps (Below Storage) -->
    <LinearLayout
        android:id="@+id/layout_steps"
        android:layout_toEndOf="@id/left_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        >
        <TextView
            android:id="@+id/text_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:includeFontPadding="false"/>
        <ImageView
            android:id="@+id/icon_steps"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="3dp"
            android:src="@drawable/ic_steps"
            android:importantForAccessibility="no"/>
    </LinearLayout>
    <!-- Screen Time (Below Steps) -->
    <LinearLayout
        android:id="@+id/layout_screen_time"
        android:layout_toEndOf="@id/left_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        >
        <TextView
            android:id="@+id/text_screen_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0h 0m"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:includeFontPadding="false"/>
        <ImageView
            android:id="@+id/icon_screen_time"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="3dp"
            android:src="@drawable/ic_time"
            android:importantForAccessibility="no"/>
    </LinearLayout>

    <!-- Calendar Events (for expanded sizes - dynamically filled) -->
    <LinearLayout
        android:id="@+id/events_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignEnd="@id/left_header"
        android:fontFamily="serif"
        android:orientation="vertical"
        android:layout_below="@id/left_header"
        android:layout_marginTop="8dp"
        android:clipChildren="true"
        android:clipToPadding="true">

        <TextView android:id="@+id/text_event_1" style="@style/EventText" android:fontFamily="serif" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_2" style="@style/EventText" android:fontFamily="serif" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_3" style="@style/EventText" android:fontFamily="serif" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_4" style="@style/EventText" android:fontFamily="serif" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_5" style="@style/EventText" android:fontFamily="serif" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_6" style="@style/EventText" android:fontFamily="serif" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_7" style="@style/EventText" android:fontFamily="serif" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_8" style="@style/EventText" android:fontFamily="serif" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_9" style="@style/EventText" android:fontFamily="serif" android:visibility="gone"/>
        <TextView android:id="@+id/text_event_10" style="@style/EventText" android:fontFamily="serif" android:visibility="gone"/>

    </LinearLayout>

    </RelativeLayout>
</RelativeLayout>
